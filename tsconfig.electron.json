{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node", "electron"]
  },
  "include": [
    "electron/**/*.cjs",
    "electron/**/*.js",
    "electron/**/*.mjs"
  ],
  "exclude": [
    ".next/**",
    "coverage/**",
    "dist-desktop/**",
    "release/**",
    "scripts/**",
    "tmp/**"
  ]
}
