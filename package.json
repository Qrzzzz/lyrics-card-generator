{
  "name": "lyric-card-generator",
  "version": "6.1.3",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "dev:clean": "npm run clean:next && next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run electron:typecheck",
    "electron:typecheck": "tsc --project tsconfig.electron.json",
    "lint": "eslint . --max-warnings=0",
    "palette:test": "tsx scripts/test-palette-extraction.ts",
    "color-field:test": "tsx scripts/test-spatial-color-field.ts",
    "background-composition:test": "tsx scripts/test-background-composition.ts",
    "background-composition:benchmark": "cross-env RUN_BACKGROUND_COMPOSITION_BENCHMARK=1 playwright test --config=playwright.web-lite.config.ts --grep @background-composition-benchmark",
    "parse:test": "tsx scripts/test-parse-song.ts",
    "music-search:normalize-test": "tsx scripts/test-netease-search-normalize.ts",
    "music-search:test": "tsx scripts/test-netease-search-live.ts",
    "security:test": "tsx scripts/test-safe-fetch.ts",
    "dependency-audit:test": "node scripts/test-production-audit-policy.mjs",
    "dependency-audit:check": "node scripts/check-production-audit.mjs",
    "dependency-audit:gate": "npm run dependency-audit:test && npm run dependency-audit:check",
    "sbom:prepare": "node scripts/prepare-release-sbom-input.mjs",
    "sbom:inspect": "node scripts/inspect-release-sbom.mjs",
    "request-boundary:test": "tsx scripts/test-app-api-request-boundary.ts",
    "transactions:test": "tsx scripts/test-document-transactions.ts && tsx scripts/test-ai-translation-transactions.ts && tsx scripts/test-ai-desktop-cancellation.ts",
    "lyrics-document-v2:test": "tsx scripts/test-lyrics-document-v2.ts",
    "export:test": "tsx scripts/test-export-transactions.ts",
    "export-readiness:test": "tsx scripts/test-export-card-readiness.ts",
    "deferred-surfaces:test": "playwright test --config=playwright.deferred-surfaces.config.ts",
    "startup-assets:test": "node scripts/test-electron-startup-orchestration.cjs && node scripts/test-static-cache-policy.mjs && node scripts/test-static-asset-equivalence.cjs",
    "p0:test": "npm run security:test && npm run request-boundary:test && npm run transactions:test && npm run export:test && npm run export-readiness:test",
    "examples:generate-palettes": "tsx scripts/generate-example-palettes.ts",
    "readme:media": "npm run build && node scripts/generate-readme-media.mjs",
    "readme:media:check": "node scripts/test-readme-media.mjs",
    "web-lite:build": "node scripts/build-web-lite.mjs",
    "web-lite:check": "node scripts/check-web-lite.mjs",
    "font-license:test": "node scripts/test-font-license-distribution.mjs",
    "pages:prepare": "node scripts/prepare-pages-site.mjs --out=_site",
    "web-lite:smoke": "playwright test --config=playwright.web-lite.config.ts",
    "web-lite:cross-browser-smoke": "playwright test --config=playwright.web-lite-cross-browser.config.ts",
    "render-boundaries:test": "next build && node scripts/prepare-render-boundary-server.mjs && node scripts/run-render-boundary-tests.mjs",
    "a11y:test": "playwright test --config=playwright.web-lite.config.ts --grep axe",
    "stability:test": "tsx scripts/test-app-preferences-reconciliation.ts && tsx scripts/test-app-preferences-behavior.ts && tsx scripts/test-shutdown-coordinator.ts && tsx scripts/test-ai-error-localization.ts && tsx scripts/test-locale-completeness.ts && node scripts/test-electron-static-analysis.cjs && node scripts/test-electron-single-instance.cjs && node scripts/test-release-workflow.cjs && node scripts/test-ci-workflow.cjs",
    "coverage": "c8 --include=lib/settings/app-preferences-reconciliation.ts --include=lib/ai/error-copy.ts --check-coverage --lines 85 --functions 85 --branches 80 --statements 85 tsx scripts/test-stability-coverage.ts",
    "electron-runtime:test": "node scripts/test-electron-runtime-coverage.cjs",
    "electron-runtime:coverage": "c8 --clean --all --include=electron/preload.js --include=electron/ipc-security.js --include=electron/url-policy.js --include=electron/local-app-url.js --include=electron/local-server-origin.js --include=electron/manual-save-ipc.js --include=electron/import-history.js --include=electron/packaged-server-readiness.js --include=electron/ai-request-registry.js --check-coverage --per-file --lines 70 --functions 75 --branches 60 --statements 70 node scripts/test-electron-runtime-coverage.cjs",
    "click-spark:test": "tsx scripts/test-click-spark-animation.ts",
    "core:test": "npm run p0:test && npm run lyrics-document-v2:test && npm run palette:test && npm run color-field:test && npm run background-composition:test && npm run startup-assets:test && node scripts/test-electron-single-instance.cjs && tsx scripts/test-import-history-ui.ts && tsx scripts/test-v2-core.ts && tsx scripts/test-v32-settings.ts && tsx scripts/test-v321-theme-tokens.ts && tsx scripts/test-light-acrylic-contrast.ts && tsx scripts/test-v34-layout-grid.ts && tsx scripts/test-artwork-geometry.ts && tsx scripts/test-auto-width.ts && tsx scripts/test-landscape-plan.ts && tsx scripts/test-stepper-layout.ts && tsx scripts/test-lyrics-workspace-layout.ts && tsx scripts/test-lyrics-workbench.ts && tsx scripts/test-lyrics-document.ts && tsx scripts/test-lyrics-viewport.ts && tsx scripts/test-titlebar-regression.ts && tsx scripts/test-examples.ts && tsx scripts/test-settings-wing.ts && tsx scripts/test-ai-settings-save-controller.ts && tsx scripts/test-release-consistency.ts && npm run click-spark:test && tsx scripts/test-motion-system.ts && tsx scripts/test-ai-provider-response.ts && tsx scripts/test-netease-search-normalize.ts && node scripts/test-electron-ai-prompt-settings.cjs && node scripts/test-electron-font-options.cjs && node scripts/test-electron-font-directory-service.cjs && node scripts/test-electron-native-font-dialog.cjs && node scripts/test-electron-user-preferences.cjs && node scripts/test-electron-background-images.cjs",
    "desktop:dev": "node scripts/start-electron-dev.mjs",
    "desktop:startup-test": "node scripts/test-electron-packaged-server-startup.cjs",
    "desktop:startup-benchmark": "node scripts/benchmark-desktop-startup.mjs",
    "desktop:packaged-assets-test": "node scripts/test-static-asset-equivalence.cjs --packaged && node scripts/test-packaged-runtime-manifest.cjs",
    "desktop:staged-assets-test": "node scripts/test-static-asset-equivalence.cjs --staged",
    "desktop:cache-header-test": "node scripts/test-packaged-static-cache-headers.cjs",
    "electron:single-instance-test": "node scripts/test-electron-single-instance.cjs",
    "font-directory:test": "node scripts/test-electron-font-directory-service.cjs",
    "desktop:single-instance-test": "node scripts/test-desktop-single-instance-interactions.mjs",
    "desktop:startup-origin-test": "node scripts/test-desktop-startup-origin-interactions.mjs",
    "desktop:prepare": "node scripts/prepare-electron-dist.mjs",
    "desktop:interaction-test": "node scripts/test-desktop-single-instance-interactions.mjs && node scripts/test-desktop-startup-origin-interactions.mjs && node scripts/test-desktop-settings-interactions.mjs && node scripts/test-desktop-import-history-interactions.mjs",
    "desktop:visual-diagnostic": "node scripts/test-desktop-settings-interactions.mjs --visual-diagnostics",
    "desktop:final-artifact-smoke": "node scripts/smoke-final-windows-artifacts.mjs",
    "desktop:size": "node scripts/audit-desktop-size.mjs",
    "desktop:pack": "npm run typecheck && npm run build && npm run desktop:prepare && electron-builder --dir --projectDir dist-desktop/app",
    "desktop:build": "npm run typecheck && npm run build && npm run desktop:prepare && electron-builder --projectDir dist-desktop/app"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.13.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "strtok3": "^10.3.5",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "electron": "42.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.23",
    "globals": "14.0.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
